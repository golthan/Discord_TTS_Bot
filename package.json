{
  "name": "discord-bot",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "prepare-env": "node scripts/prepare-env.js",
    "desktop": "npm run build && npm run prepare-env && electron .",
    "dist": "npm run build && npm run prepare-env && electron-builder --win",
    "dist:share": "npm run build && node scripts/prepare-env.js --clear && electron-builder --win -c.portable.artifactName=DiscordTTSBot-Share.${ext}"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.2",
    "quick-lru": "^7.0.0",
    "undici": "^7.8.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.13.14",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.golthan.discordttsbot",
    "productName": "Discord TTS Bot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "DiscordTTSBot.${ext}"
    }
  }
}
